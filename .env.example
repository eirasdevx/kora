# Local development database. Use a real value in your local `.env`.
LOCAL_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"

# Hosted database used in production-like environments.
# If you only work locally, you can leave this empty.
DATABASE_URL=""

# Optional: set to `1` only when you want Prisma target diagnostics in logs.
KORA_LOG_DATABASE_TARGET="0"
